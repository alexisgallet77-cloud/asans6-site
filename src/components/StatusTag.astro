---
import { useTranslations } from '@/i18n/ui';

interface Props {
  status: 'dev' | 'soon' | 'live';
  class?: string;
}
const { status, class: className } = Astro.props;
const t = useTranslations();
const dot = {
  live: 'bg-brand',
  dev: 'bg-accent',
  soon: 'border border-muted',
}[status];
---

<span
  class:list={[
    'inline-flex items-center gap-2 border border-line-strong px-2.5 py-1 font-mono text-[0.6875rem] font-medium tracking-[0.08em] text-ink uppercase',
    className,
  ]}
>
  <span aria-hidden="true" class:list={['size-1.5 rounded-full', dot]}></span>
  {t(`status.${status}`)}
</span>
