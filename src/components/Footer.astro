---
import Logo from './Logo.astro';
import { href } from '@/lib/url';
import { site } from '@/config/site';

const nav = [
  { path: '/', label: 'Accueil' },
  { path: '/produits', label: 'Produits' },
  { path: '/a-propos', label: 'À propos' },
  { path: '/contact', label: 'Contact' },
];
const legal = [
  { path: '/mentions-legales', label: 'Mentions légales' },
  { path: '/confidentialite', label: 'Confidentialité' },
];
---

<footer class="mt-auto border-t border-line">
  <div class="container-page grid gap-10 py-12 md:grid-cols-12 md:py-16">
    <div class="md:col-span-5">
      <Logo size={30} />
      <p class="mt-5 max-w-[34ch] text-[0.9375rem] text-muted">
        {site.tagline}. Nous concevons, développons et maintenons nos propres produits.
      </p>
    </div>
    <nav aria-label="Plan du site" class="md:col-span-4">
      <ul class="grid grid-cols-2 gap-x-6 gap-y-2 text-[0.9375rem]" role="list">
        {
          nav.map((l) => (
            <li>
              <a href={href(l.path)} class="text-ink transition-colors hover:text-brand">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="text-[0.9375rem] md:col-span-3">
      {
        site.contact.email ? (
          <a class="link" href={`mailto:${site.contact.email}`}>
            {site.contact.email}
          </a>
        ) : (
          <span class="todo">[À FOURNIR : e-mail]</span>
        )
      }
      <p class="mt-3">
        <a href={href('/contact')} class="link">Formulaire de contact</a>
      </p>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="container-page flex flex-wrap justify-between gap-x-6 gap-y-2 py-5 text-[0.875rem] text-muted">
      <p>© {new Date().getFullYear()} {site.name} {site.legalForm}</p>
      <ul class="flex gap-6" role="list">
        {
          legal.map((l) => (
            <li>
              <a href={href(l.path)} class="transition-colors hover:text-ink">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
