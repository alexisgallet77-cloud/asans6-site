---
/**
 * Pied de page en forme de cartouche (bloc d'identification d'un plan technique).
 */
import Logo from './Logo.astro';
import Todo from './Todo.astro';
import { href } from '@/lib/url';
import { site } from '@/config/site';
import { useTranslations } from '@/i18n/ui';

interface Props {
  /** Numéro de feuille de la page courante, ex. « 03 ». */
  sheet?: string;
}
const { sheet } = Astro.props;
const t = useTranslations();
const year = new Date().getFullYear();

const nav = [
  { path: '/', label: t('nav.home') },
  { path: '/produits', label: t('nav.products') },
  { path: '/a-propos', label: t('nav.about') },
  { path: '/contact', label: t('nav.contact') },
];
const legal = [
  { path: '/mentions-legales', label: t('footer.legal') },
  { path: '/confidentialite', label: t('footer.privacy') },
];
---

<footer class="mt-auto border-t border-line">
  <div class="container-page py-12 md:py-16">
    <div class="grid border border-line-strong lg:grid-cols-12">
      <div class="border-b border-line-strong p-6 lg:col-span-5 lg:border-r lg:border-b-0 md:p-8">
        <Logo size={30} />
        <p class="mt-5 max-w-[34ch] text-[0.9375rem] text-muted">
          {site.tagline}. Nous concevons, développons et maintenons nos propres produits.
        </p>
      </div>

      <nav
        aria-label="Plan du site"
        class="border-b border-line-strong p-6 lg:col-span-4 lg:border-r lg:border-b-0 md:p-8"
      >
        <p class="label mb-4">Plan du site</p>
        <ul class="grid grid-cols-2 gap-x-6 gap-y-2 text-[0.9375rem]" role="list">
          {
            [...nav, ...legal].map((l) => (
              <li>
                <a href={href(l.path)} class="text-ink transition-colors hover:text-brand">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="p-6 lg:col-span-3 md:p-8">
        <p class="label mb-4">Contact</p>
        <p class="text-[0.9375rem]">
          {site.contact.email ? <a class="link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a> : <Todo>e-mail</Todo>}
        </p>
        <p class="mt-3 text-[0.9375rem]">
          <a href={href('/contact')} class="link">Formulaire de contact</a>
        </p>
      </div>

      <dl
        class="col-span-full grid grid-cols-2 border-t border-line-strong font-mono text-[0.75rem] uppercase tracking-[0.06em] sm:grid-cols-4"
      >
        <div class="border-r border-b border-line-strong px-4 py-3 sm:border-b-0 md:px-6">
          <dt class="text-muted">Société</dt>
          <dd class="mt-1 text-ink">{site.name} {site.legalForm}</dd>
        </div>
        <div class="border-b border-line-strong px-4 py-3 sm:border-r sm:border-b-0 md:px-6">
          <dt class="text-muted">{t('footer.revision')}</dt>
          <dd class="mt-1 text-ink">{site.revision}</dd>
        </div>
        <div class="border-r border-line-strong px-4 py-3 md:px-6">
          <dt class="text-muted">{t('footer.sheet')}</dt>
          <dd class="mt-1 text-ink">{sheet ?? '—'}</dd>
        </div>
        <div class="px-4 py-3 md:px-6">
          <dt class="text-muted">Droits</dt>
          <dd class="mt-1 text-ink">© {year} {site.name}</dd>
        </div>
      </dl>
    </div>
  </div>
</footer>
