---
import Base from '@/layouts/Base.astro';
import CtaBand from '@/components/CtaBand.astro';
import { href } from '@/lib/url';

/** Fondateurs : remplacer les `null` par les informations réelles. */
const founders: { name: string | null; role: string | null; bio: string | null }[] = [
  { name: null, role: null, bio: null },
  { name: null, role: null, bio: null },
  { name: null, role: null, bio: null },
];

const principles = [
  ['Des produits ciblés', 'Nous préférons résoudre complètement un problème précis plutôt qu’en effleurer plusieurs.'],
  ['La rigueur comme méthode', 'Tests, revues de code, mesures : ce qui n’est pas vérifié n’est pas considéré comme terminé.'],
  ['Le temps long', 'Un logiciel vit des années après sa mise en ligne. Nous le concevons pour être maintenu, pas seulement livré.'],
  ['La transparence', 'Dire ce qu’un produit fait, ce qu’il ne fait pas encore, et comment il traite les données qu’on lui confie.'],
];
const initials = (name: string) => name.split(' ').map((w) => w[0]).join('').slice(0, 2);
---

<Base
  title="À propos"
  description="Asans6 est une société fondée par trois ingénieurs pour concevoir, développer et maintenir ses propres produits logiciels. Histoire, fondateurs et vision."
>
  <section class="container-page pt-12 pb-16 md:pt-20 md:pb-24" aria-labelledby="titre">
    <div class="grid gap-8 lg:grid-cols-12">
      <h1 id="titre" class="max-w-[16ch] text-display font-bold lg:col-span-8">Une société fondée par trois ingénieurs.</h1>
      <p class="max-w-[44ch] self-end text-lede text-muted lg:col-span-4">
        Nous construisons des logiciels pour des problèmes concrets, et nous les maintenons dans la durée.
      </p>
    </div>
  </section>

  <!-- Histoire -->
  <section class="border-t border-line" aria-labelledby="histoire">
    <div class="container-page section-y grid gap-8 lg:grid-cols-12">
      <h2 id="histoire" class="text-h2 font-[650] lg:col-span-5">Pourquoi Asans6.</h2>
      <div class="space-y-5 lg:col-span-6 lg:col-start-7 lg:pt-2">
        <p class="text-lede">
          Les trois fondateurs d’Asans6 sont ingénieurs. Ils ont créé la société pour porter leurs propres produits
          logiciels, du premier prototype à la maintenance.
        </p>
        <p class="text-muted">
          Le premier, Factually, répond à un problème devenu quotidien : vérifier une information demande du temps, et ce
          temps manque. Le second, Tixa, part du métier de chauffeur de taxi et de ses contraintes très concrètes.
        </p>
        <p><span class="todo">[À FOURNIR : date de création, contexte de la fondation, origine du nom Asans6]</span></p>
      </div>
    </div>
  </section>

  <!-- Fondateurs -->
  <section class="border-y border-line bg-surface" aria-labelledby="fondateurs">
    <div class="container-page section-y">
      <h2 id="fondateurs" class="text-h2 font-[650]">Les fondateurs.</h2>
      <ul class="mt-10 border-t border-line-strong md:mt-14" role="list">
        {
          founders.map((f, i) => (
            <li class="grid gap-6 border-b border-line-strong py-8 sm:grid-cols-[6rem_1fr] md:grid-cols-12 md:gap-8 md:py-10">
              <div class="grid size-24 place-items-center border border-line-strong bg-bg md:col-span-2" aria-hidden="true">
                <span class="font-display text-[2rem] font-bold text-muted">{f.name ? initials(f.name) : i + 1}</span>
              </div>
              <div class="md:col-span-4 md:col-start-4">
                <h3 class="text-h3 font-semibold">{f.name ?? <span class="todo">[À FOURNIR : prénom et nom]</span>}</h3>
                <p class="mt-2 text-muted">{f.role ?? <span class="todo">[À FOURNIR : rôle]</span>}</p>
              </div>
              <p class="max-w-[52ch] text-muted sm:col-start-2 md:col-span-5 md:col-start-8">
                {f.bio ?? <span class="todo">[À FOURNIR : parcours en deux ou trois lignes, photo]</span>}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Vision -->
  <section class="container-page section-y" aria-labelledby="vision">
    <h2 id="vision" class="max-w-[22ch] text-h2 font-[650]">
      Peu de produits, bien faits, <span class="text-muted">et tenus dans la durée.</span>
    </h2>
    <dl class="mt-10 md:mt-14">
      {
        principles.map(([title, text]) => (
          <div class="border-t border-line py-6 md:grid md:grid-cols-12 md:gap-8">
            <dt class="text-h3 font-display font-semibold md:col-span-5">{title}</dt>
            <dd class="mt-2 max-w-[52ch] text-muted md:col-span-6 md:col-start-7 md:mt-0">{text}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <CtaBand
    title="Parlons de votre besoin."
    text="Démonstration, partenariat ou question de presse : écrivez-nous."
    button="Nous écrire"
    href={href('/contact')}
  />
</Base>
