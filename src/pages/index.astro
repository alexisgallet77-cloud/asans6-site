---
import Base from '@/layouts/Base.astro';
import Cartouche from '@/components/Cartouche.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { products } from '@/data/products';
import { href } from '@/lib/url';
import { site } from '@/config/site';

const skills = [
  ['Traitement automatique du langage', 'Analyser un texte, en extraire les affirmations, comparer leur sens avec celui des sources.'],
  ['Recherche d’information', 'Interroger des sources variées, classer les résultats par pertinence, garder la trace de chaque document.'],
  ['Applications mobiles', 'Des interfaces simples, pensées pour être utilisées en situation réelle, avec peu de temps et peu d’attention.'],
  ['Architecture back-end et API', 'Des services fiables, observables et documentés, conçus pour évoluer sans tout réécrire.'],
  ['Sécurité et données personnelles', 'Protéger les données dès la conception et appliquer les principes du RGPD à chaque produit.'],
  ['Qualité logicielle', 'Tests automatisés, revue de code, intégration et déploiement continus.'],
];

const method = [
  ['Partir du métier', 'Observer le travail réel avant d’écrire la première ligne de code.'],
  ['Prototyper tôt', 'Confronter une première version à de vrais utilisateurs, le plus vite possible.'],
  ['Mesurer', 'Juger un produit sur ce qu’il change pour ses utilisateurs, pas sur sa liste de fonctions.'],
  ['Maintenir', 'Corriger, sécuriser et améliorer dans la durée : c’est là que se joue la qualité.'],
];
---

<Base description={site.description}>
  <!-- Ouverture -->
  <section class="container-page pt-12 pb-16 md:pt-20 md:pb-24" aria-labelledby="titre">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-8">
        <h1 id="titre" class="max-w-[17ch] text-display font-bold" data-intro>
          Des logiciels conçus par des ingénieurs, pour des problèmes précis.
        </h1>
        <p class="mt-8 max-w-[56ch] text-lede text-muted" data-intro style="--i:1">
          Asans6 conçoit, développe et maintient ses propres produits. Le premier, <a
            href={href('/produits/factually')}
            class="link font-medium">Factually</a
          >, aide à vérifier l’information avec l’appui de l’intelligence artificielle. Le suivant, Tixa, s’adresse
          aux chauffeurs de taxi.
        </p>
        <div class="mt-10 flex flex-wrap gap-3" data-intro style="--i:2">
          <a href={href('/contact')} class="btn btn-primary">Nous écrire <Icon name="arrow-right" size={18} class="btn-arrow" /></a>
          <a href={href('/produits')} class="btn btn-secondary">Voir les produits <Icon name="arrow-right" size={18} class="btn-arrow" /></a>
        </div>
      </div>
      <div class="lg:col-span-4 lg:pt-3" data-intro style="--i:3">
        <Cartouche
          title="Fiche société"
          reference="A6-00"
          rows={[
            { label: 'Raison sociale', value: `${site.name} ${site.legalForm}` },
            { label: 'Activité', value: 'Conception et édition de logiciels' },
            { label: 'Fondateurs', value: 'Trois ingénieurs' },
            { label: 'Produits', value: products.map((p) => p.name).join(' · ') },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- Ce que nous faisons -->
  <section class="border-t border-line" aria-labelledby="metier">
    <div class="container-page section-y grid gap-8 lg:grid-cols-12">
      <h2 id="metier" class="text-h2 font-[650] lg:col-span-5" data-reveal>Un éditeur de logiciels, de l’idée à la maintenance.</h2>
      <div class="space-y-5 lg:col-span-6 lg:col-start-7 lg:pt-2" data-reveal style="--i:2">
        <p class="text-lede">
          Asans6 porte ses propres produits logiciels. Nous les concevons, les développons, les mettons en production et
          les maintenons.
        </p>
        <p class="text-muted">
          Chaque produit part d’un problème concret, observé chez les personnes qui le vivent : une rédaction qui manque de
          temps pour vérifier, un chauffeur qui ne peut pas décrocher en roulant.
        </p>
      </div>
    </div>
  </section>

  <!-- Produits : index en lignes -->
  <section class="border-y border-line bg-surface" aria-labelledby="produits">
    <div class="container-page section-y">
      <h2 id="produits" class="text-h2 font-[650]" data-reveal>Nos produits.</h2>
      <ul class="mt-10 border-t border-line-strong md:mt-14" role="list">
        {
          products.map((p, i) => (
            <li class="border-b border-line-strong" data-reveal style={`--i:${i + 1}`}>
              <a
                href={href(`/produits/${p.slug}`)}
                class="product-row group grid gap-x-8 gap-y-3 py-8 md:grid-cols-12 md:items-baseline md:py-10"
              >
                <span class="md:col-span-4">
                  <span class="block font-display text-[clamp(2rem,1.5rem+2.2vw,3.25rem)] leading-none font-bold tracking-[-0.03em] text-ink transition-colors group-hover:text-brand">
                    {p.name}
                  </span>
                  <span class="status mt-4" data-status={p.status}>{p.status}</span>
                </span>
                <span class="max-w-[52ch] text-muted md:col-span-7">
                  <span class="mb-2 block font-medium text-ink">{p.tagline}</span>
                  {p.summary}
                </span>
                <span class="hidden justify-end text-ink md:col-span-1 md:flex">
                  <Icon name="arrow-right" size={24} class="row-arrow" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-[0.9375rem] text-muted">D’autres produits suivront.</p>
    </div>
  </section>

  <!-- Compétences -->
  <section class="container-page section-y" aria-labelledby="competences">
    <h2 id="competences" class="max-w-[20ch] text-h2 font-[650]" data-reveal>Les compétences derrière nos produits.</h2>
    <dl class="mt-10 grid gap-x-10 md:mt-14 md:grid-cols-2">
      {
        skills.map(([title, text], i) => (
          <div class="border-t border-line py-6" data-reveal style={`--i:${i}`}>
            <dt class="text-h3 font-display font-semibold">{title}</dt>
            <dd class="mt-2 max-w-[46ch] text-muted">{text}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Méthode -->
  <section class="border-t border-line" aria-labelledby="methode">
    <div class="container-page section-y">
      <h2 id="methode" class="max-w-[26ch] text-h2 font-[650]" data-reveal>
        Un logiciel n’est pas fini quand il est livré.
        <span class="text-muted">Il l’est quand il est utile, et il le reste tant qu’il est maintenu.</span>
      </h2>
      <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6" role="list">
        {
          method.map(([title, text], i) => (
            <li>
              <span class="block h-0.5 bg-ink" data-reveal="line" style={`--i:${i * 2}`} aria-hidden="true"></span>
              <div class="pt-5" data-reveal style={`--i:${i * 2 + 1}`}>
              <p class="font-mono text-[0.875rem] text-muted">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-3 text-h3 font-semibold">{title}</h3>
              <p class="mt-2 text-muted">{text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand
    title="Une démonstration, un partenariat, une question de presse ?"
    text="Décrivez votre demande en quelques lignes. Nous vous répondrons personnellement."
    button="Nous écrire"
    href={href('/contact')}
  />
</Base>

<style>
  .product-row :global(.row-arrow) {
    transition: translate 200ms var(--ease-out);
  }
  .product-row:hover :global(.row-arrow) {
    translate: 4px 0;
  }
</style>
