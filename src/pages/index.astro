---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Cartouche from '@/components/Cartouche.astro';
import SectionHead from '@/components/SectionHead.astro';
import StatusTag from '@/components/StatusTag.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import { href } from '@/lib/url';
import { site } from '@/config/site';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);

const skills = [
  {
    title: 'Traitement automatique du langage',
    text: 'Analyser un texte, en extraire les affirmations, comparer leur sens avec celui des sources.',
  },
  {
    title: 'Recherche d’information',
    text: 'Interroger des sources variées, classer les résultats par pertinence, garder la trace de chaque document.',
  },
  {
    title: 'Applications mobiles',
    text: 'Des interfaces simples, pensées pour être utilisées en situation réelle, avec peu de temps et peu d’attention.',
  },
  {
    title: 'Architecture back-end et API',
    text: 'Des services fiables, observables et documentés, conçus pour évoluer sans tout réécrire.',
  },
  {
    title: 'Sécurité et données personnelles',
    text: 'Protéger les données dès la conception et appliquer les principes du RGPD à chaque produit.',
  },
  {
    title: 'Qualité logicielle',
    text: 'Tests automatisés, revue de code, intégration et déploiement continus.',
  },
];

const method = [
  { title: 'Partir du métier', text: 'Observer le travail réel avant d’écrire la première ligne de code.' },
  { title: 'Prototyper tôt', text: 'Confronter une première version à de vrais utilisateurs, le plus vite possible.' },
  { title: 'Mesurer', text: 'Juger un produit sur ce qu’il change pour ses utilisateurs, pas sur sa liste de fonctions.' },
  { title: 'Maintenir', text: 'Corriger, sécuriser et améliorer dans la durée : c’est là que se joue la qualité.' },
];
---

<Base description={site.description} sheet="01 / 08">
  <!-- Ouverture -->
  <section class="container-page pt-12 pb-16 md:pt-20 md:pb-24" aria-labelledby="titre">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-8">
        <p class="label flex flex-wrap items-center gap-x-3 gap-y-1">
          <span class="text-ink">{site.name}</span>
          <span aria-hidden="true" class="h-px w-6 bg-line-strong"></span>
          <span>{site.tagline}</span>
        </p>
        <h1 id="titre" class="mt-6 max-w-[17ch] text-display font-bold">
          Des logiciels conçus par des ingénieurs, pour des problèmes précis.
        </h1>
        <p class="mt-8 max-w-[56ch] text-lede text-muted">
          Asans6 conçoit, développe et maintient ses propres produits. Le premier, <a
            href={href('/produits/factually')}
            class="link font-medium">Factually</a
          >, aide à vérifier l’information avec l’appui de l’intelligence artificielle. Le suivant, Tixa, s’adresse
          aux chauffeurs de taxi.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <Button href={href('/contact')}>Nous écrire</Button>
          <Button href={href('/produits')} variant="secondary">Voir les produits</Button>
        </div>
      </div>

      <div class="lg:col-span-4 lg:pt-3">
        <Cartouche
          title="Fiche société"
          reference="A6-00"
          rows={[
            { label: 'Raison sociale', value: `${site.name} ${site.legalForm}` },
            { label: 'Activité', value: 'Conception et édition de logiciels' },
            { label: 'Fondateurs', value: 'Trois ingénieurs' },
            { label: 'Produits', value: products.map((p) => p.data.name).join(' · ') },
          ]}
        />
      </div>
    </div>

    <div class="ruler mt-16 md:mt-24" aria-hidden="true"></div>
  </section>

  <!-- § 01 — Ce que nous faisons -->
  <section class="container-page section-y pt-0" aria-labelledby="s1">
    <SectionHead number="01" label="Ce que nous faisons" id="s1">
      Un éditeur de logiciels, de l’idée à la maintenance.
    </SectionHead>
    <div class="mt-10 grid gap-8 lg:grid-cols-12 lg:gap-8">
      <div class="grid gap-6 text-body md:grid-cols-2 lg:col-span-9 lg:col-start-4 lg:gap-10">
        <p>
          Asans6 porte ses propres produits logiciels. Nous les concevons, les développons, les mettons en production et
          les maintenons. Chaque étape est tenue par l’équipe qui a écrit le code.
        </p>
        <p class="text-muted">
          Chaque produit part d’un problème concret, observé chez les personnes qui le vivent : une rédaction qui manque de
          temps pour vérifier, un chauffeur qui ne peut pas décrocher en roulant.
        </p>
      </div>
    </div>
  </section>

  <!-- § 02 — Produits : index en lignes -->
  <section class="border-y border-line bg-surface" aria-labelledby="s2">
    <div class="container-page section-y">
      <SectionHead number="02" label="Produits" id="s2">Nos produits.</SectionHead>

      <ol class="mt-12 border-t border-line-strong md:mt-16" role="list">
        {
          products.map((p, i) => (
            <li class="border-b border-line-strong">
              <a
                href={href(`/produits/${p.id}`)}
                class="product-row group grid gap-x-8 gap-y-3 py-8 md:grid-cols-12 md:items-baseline md:py-10"
              >
                <span class="label text-brand md:col-span-1">{String(i + 1).padStart(2, '0')}</span>
                <span class="md:col-span-4">
                  <span class="block font-display text-[clamp(2rem,1.5rem+2.2vw,3.25rem)] leading-none font-bold tracking-[-0.03em] text-ink transition-colors group-hover:text-brand">
                    {p.data.name}
                  </span>
                  <StatusTag status={p.data.status} class="mt-4" />
                </span>
                <span class="max-w-[52ch] text-muted md:col-span-6">
                  <span class="mb-2 block font-medium text-ink">{p.data.tagline}</span>
                  {p.data.summary}
                </span>
                <span class="hidden justify-end text-ink md:col-span-1 md:flex">
                  <Icon name="arrow-right" size={24} class="row-arrow" />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="mt-6 text-[0.9375rem] text-muted md:pl-[calc((100%+2rem)/12)]">
        D’autres produits suivront. Chacun aura sa page ici.
      </p>
    </div>
  </section>

  <!-- § 03 — Compétences : tableau en deux colonnes -->
  <section class="container-page section-y" aria-labelledby="s3">
    <SectionHead number="03" label="Compétences" id="s3">Les compétences derrière nos produits.</SectionHead>
    <dl class="mt-12 grid gap-x-10 md:mt-16 md:grid-cols-2">
      {
        skills.map((s, i) => (
          <div class="border-t border-line py-6">
            <dt class="grid grid-cols-[3.5rem_1fr] items-baseline gap-x-4">
              <span class="label" aria-hidden="true">
                03.{i + 1}
              </span>
              <span class="text-h3 font-display font-semibold">{s.title}</span>
            </dt>
            <dd class="mt-2 max-w-[46ch] pl-[4.5rem] text-muted">{s.text}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- § 04 — Méthode : énoncé + étapes -->
  <section class="border-t border-line" aria-labelledby="s4">
    <div class="container-page section-y">
      <div class="grid gap-8 lg:grid-cols-12">
        <p class="label flex items-center gap-3 self-start lg:col-span-3 lg:pt-3">
          <span class="text-brand">§ 04</span>
          <span aria-hidden="true" class="h-px w-6 bg-line-strong"></span>
          <span>Méthode</span>
        </p>
        <h2 id="s4" class="text-h2 font-[650] lg:col-span-9">
          Un logiciel n’est pas fini quand il est livré.
          <span class="text-muted">Il l’est quand il est utile, et il le reste tant qu’il est maintenu.</span>
        </h2>
      </div>
      <ol class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6" role="list">
        {
          method.map((m, i) => (
            <li class="border-t-2 border-ink pt-5">
              <p class="font-mono text-[0.875rem] text-muted">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-3 text-h3 font-semibold">{m.title}</h3>
              <p class="mt-2 text-muted">{m.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand
    number="05"
    title="Une démonstration, un partenariat, une question de presse ?"
    text="Décrivez votre demande en quelques lignes. Nous vous répondrons personnellement."
    button="Nous écrire"
    href={href('/contact')}
  />
</Base>

<style>
  .ruler {
    height: 0.75rem;
    border-top: 1px solid var(--line-strong);
    background-image:
      linear-gradient(to right, var(--line-strong) 1px, transparent 1px),
      linear-gradient(to right, var(--line-strong) 1px, transparent 1px);
    background-size:
      4rem 0.75rem,
      0.5rem 0.375rem;
    background-repeat: repeat-x;
  }
  .product-row {
    transition: background-color 200ms var(--ease-out);
  }
  .product-row :global(.row-arrow) {
    transition: translate 200ms var(--ease-out);
  }
  .product-row:hover :global(.row-arrow) {
    translate: 4px 0;
  }
</style>
