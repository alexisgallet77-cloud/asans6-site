---
import Base from '@/layouts/Base.astro';
import Cartouche from '@/components/Cartouche.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { products } from '@/data/products';
import { href } from '@/lib/url';
---

<Base
  title="Produits"
  description="Les produits logiciels d’Asans6 : Factually, la vérification des faits assistée par IA, et Tixa, l’application des chauffeurs de taxi."
>
  <section class="container-page pt-12 pb-12 md:pt-20 md:pb-16" aria-labelledby="titre">
    <div class="grid gap-8 lg:grid-cols-12">
      <h1 id="titre" class="text-display font-bold lg:col-span-7">Ce que nous construisons.</h1>
      <p class="max-w-[48ch] self-end text-lede text-muted lg:col-span-5">
        Chaque produit répond à un problème précis, pour un public précis. Les voici, du plus avancé au plus récent.
      </p>
    </div>
  </section>

  <div class="container-page pb-16 md:pb-24">
    {
      products.map((p, i) => (
        <article class="grid gap-10 border-t-2 border-ink py-12 md:py-16 lg:grid-cols-12 lg:gap-8" aria-labelledby={`p-${p.slug}`}>
          <div class="lg:col-span-7">
            <h2 id={`p-${p.slug}`} class="font-display text-[clamp(2.5rem,1.8rem+3vw,4.5rem)] leading-none font-bold tracking-[-0.03em]">
              {p.name}
            </h2>
            <span class="status mt-5" data-status={p.status}>{p.status}</span>
            <p class="mt-8 max-w-[30ch] font-display text-h3 font-semibold">{p.tagline}</p>
            <p class="mt-4 max-w-[56ch] text-muted">{p.summary}</p>
            <a href={href(`/produits/${p.slug}`)} class:list={['btn mt-8', i === 0 ? 'btn-primary' : 'btn-secondary']}>
              Découvrir {p.name} <Icon name="arrow-right" size={18} class="btn-arrow" />
            </a>
          </div>
          <div class="lg:col-span-5">
            <Cartouche title="Fiche technique" reference={`${p.name.slice(0, 3).toUpperCase()}-0${i + 1}`} rows={p.spec} />
          </div>
        </article>
      ))
    }
    <p class="border-t border-line pt-6 text-[0.9375rem] text-muted">D’autres produits suivront.</p>
  </div>

  <CtaBand
    title="Un usage, une idée, un partenariat ?"
    text="Si l’un de nos produits pourrait servir dans votre organisation, ou si vous voyez un problème que nous devrions résoudre, écrivez-nous."
    button="Nous écrire"
    href={href('/contact')}
  />
</Base>
