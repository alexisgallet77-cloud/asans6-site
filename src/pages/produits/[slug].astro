---
/** Modèle de page produit : problème -> solution -> fonctionnement -> bénéfices -> contact. */
import Base from '@/layouts/Base.astro';
import Cartouche from '@/components/Cartouche.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { products, type Product } from '@/data/products';
import { href } from '@/lib/url';

export function getStaticPaths() {
  return products.map((product, i) => ({
    params: { slug: product.slug },
    props: { product, next: products[(i + 1) % products.length] },
  }));
}

interface Props {
  product: Product;
  next: Product;
}
const { product: p, next } = Astro.props;
const contactHref = `${href('/contact')}?sujet=${p.slug}`;
const statusNote = {
  'En développement': `${p.name} est en cours de développement. Cette page décrit le produit que nous construisons.`,
  'À venir': `${p.name} est en préparation. Cette page présente le produit que nous allons construire.`,
  Disponible: null,
}[p.status];
---

<Base title={p.name} description={p.seoDescription}>
  <!-- Ouverture -->
  <section class="container-page pt-12 pb-16 md:pt-20 md:pb-24" aria-labelledby="titre">
    <nav aria-label="Fil d’Ariane" class="text-[0.875rem] text-muted">
      <a href={href('/produits')} class="hover:text-brand">Produits</a>
      <span aria-hidden="true" class="mx-2">/</span>
      <span aria-current="page" class="text-ink">{p.name}</span>
    </nav>

    <div class="mt-10 grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <span class="status" data-status={p.status}>{p.status}</span>
        <h1 id="titre" class="mt-6 text-display font-bold">{p.name}</h1>
        <p class="mt-6 max-w-[24ch] font-display text-[clamp(1.25rem,1.1rem+0.8vw,2rem)] leading-tight font-semibold">
          {p.tagline}
        </p>
        <p class="mt-6 max-w-[58ch] text-lede text-muted">{p.summary}</p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={contactHref} class="btn btn-primary">{p.cta.button} <Icon name="arrow-right" size={18} class="btn-arrow" /></a>
          <a href="#fonctionnement" class="btn btn-secondary">Comment ça marche</a>
        </div>
      </div>
      <div class="lg:col-span-5 lg:pt-2">
        <Cartouche title="Fiche technique" reference={`${p.name.slice(0, 3).toUpperCase()}-0${products.indexOf(p) + 1}`} rows={p.spec}>
          {statusNote && <p class="border-t border-line-strong px-5 py-4 text-[0.875rem] leading-relaxed text-muted">{statusNote}</p>}
        </Cartouche>
      </div>
    </div>
  </section>

  <!-- Problème et solution -->
  <section class="border-t border-line" aria-labelledby="probleme">
    <div class="container-page section-y grid gap-8 lg:grid-cols-12">
      <h2 id="probleme" class="text-h2 font-[650] lg:col-span-5">{p.problem.title}</h2>
      <div class="space-y-5 lg:col-span-6 lg:col-start-7 lg:pt-2">
        {p.problem.paragraphs.map((t, i) => <p class:list={[i === 0 ? 'text-lede' : 'text-muted']}>{t}</p>)}
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-surface" aria-labelledby="solution">
    <div class="container-page section-y grid gap-8 lg:grid-cols-12">
      <h2 id="solution" class="text-h2 font-[650] lg:col-span-5">{p.solution.title}</h2>
      <div class="space-y-5 lg:col-span-6 lg:col-start-7 lg:pt-2">
        {p.solution.paragraphs.map((t, i) => <p class:list={[i === 0 ? 'text-lede' : 'text-muted']}>{t}</p>)}
      </div>
    </div>
  </section>

  <!-- Fonctionnement -->
  <section class="container-page section-y" aria-labelledby="fonctionnement">
    <h2 id="fonctionnement" class="text-h2 font-[650]">Comment ça marche.</h2>
    <ol class="mt-10 md:mt-14" role="list">
      {
        p.steps.map((s, i) => (
          <li class="grid gap-x-8 gap-y-2 border-t border-line py-7 md:grid-cols-12 md:py-9">
            <span class="font-display text-[2.5rem] leading-none font-bold tracking-[-0.03em] text-accent md:col-span-2" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="text-h3 font-semibold md:col-span-4">
              <span class="sr-only">Étape {i + 1} : </span>
              {s.title}
            </h3>
            <p class="max-w-[52ch] text-muted md:col-span-6">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Bénéfices -->
  <section class="border-t border-line" aria-labelledby="benefices">
    <div class="container-page section-y">
      <h2 id="benefices" class="text-h2 font-[650]">Ce que {p.name} change.</h2>
      <ul class="mt-10 grid border-t border-l border-line-strong sm:grid-cols-2 md:mt-14" role="list">
        {
          p.benefits.map((b) => (
            <li class="border-r border-b border-line-strong p-6 sm:last:odd:col-span-2 md:p-10">
              <Icon name="check" size={22} class="text-brand" />
              <h3 class="mt-5 text-h3 font-semibold">{b.title}</h3>
              <p class="mt-3 max-w-[44ch] text-muted">{b.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand title={p.cta.title} text={p.cta.text} button={p.cta.button} href={contactHref} />

  {
    next.slug !== p.slug && (
      <nav aria-label="Produit suivant" class="container-page pt-16 md:pt-24">
        <a href={href(`/produits/${next.slug}`)} class="group flex items-end justify-between gap-6 border-b border-line-strong pb-8">
          <span>
            <span class="block text-[0.875rem] text-muted">Produit suivant</span>
            <span class="mt-2 block font-display text-h2 font-bold transition-colors group-hover:text-brand">{next.name}</span>
          </span>
          <Icon name="arrow-right" size={32} class="mb-2 shrink-0 transition-transform group-hover:translate-x-1.5" />
        </a>
      </nav>
    )
  }
</Base>
