---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/config/site';
import { href } from '@/lib/url';

interface Props {
  /** Titre de la page (sans le nom de la société). Omis sur l'accueil. */
  title?: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${href('/')}og-default.png`, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Thème avant le premier affichage (évite le flash) : choix mémorisé, sinon réglage du système. -->
    <script is:inline>
      (function () {
        var t = null;
        try {
          t = localStorage.getItem('theme');
        } catch (e) {}
        if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
        // Animations d'apparition seulement si le mouvement est autorisé (sinon tout reste visible).
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window)
          document.documentElement.classList.add('motion');
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={`${href('/')}favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${href('/')}apple-touch-icon.png`} />
    <link rel="sitemap" href={`${href('/')}sitemap-index.xml`} />
    <meta name="theme-color" content="#f4f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#07101d" media="(prefers-color-scheme: dark)" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#contenu"
      class="sr-only z-50 bg-brand px-4 py-3 text-on-brand focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Aller au contenu
    </a>
    <Header />
    <main id="contenu" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
    <script>
      // Révèle chaque [data-reveal] une seule fois, quand il entre dans l'écran.
      const items = document.querySelectorAll('[data-reveal]');
      if (document.documentElement.classList.contains('motion')) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
